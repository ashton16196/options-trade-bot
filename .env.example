# Copy to .env and fill in. NEVER commit .env.

# Discord bot token from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Alpaca keys from https://app.alpaca.markets (paper keys are instant).
# Needed when broker: alpaca (both paper and live modes).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Robinhood credentials — only when broker: robinhood. Heads up: Robinhood
# removed authenticator-app 2FA in 2025, so logins may need in-app device
# approval roughly daily; run interactively the first time. See
# bot/brokers/robinhood.py for the full caveats.
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
# Only for legacy accounts that still have TOTP 2FA (base32 secret, not a code)
ROBINHOOD_TOTP_SECRET=

# Final safety latch: live orders are refused unless this is exactly "yes"
TRADE_BOT_CONFIRM_LIVE=no
